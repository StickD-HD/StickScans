# À copier vers /etc/stickscans-<instance>.env (puis : chmod 600). Ne jamais commiter de vraies valeurs.
# Mets le mot de passe entre guillemets ; un seul $ par caractère $ (pas de doublement).
PORT=8430
AUTH_USERNAME=admin
AUTH_PASSWORD="change-moi"

# Dossier partagé entre instances (le même pour toutes) : pages récupérées, espacement des requêtes,
# plafond quotidien et pause après un refus du site sont alors communs à tout le serveur.
SCRAPE_CACHE_DIR=/opt/stickscans/cache

# Rythme des requêtes vers le site (valeurs par défaut, à ne baisser qu'avec prudence) :
# FETCH_MIN_GAP_SECONDS=45
# FETCH_MAX_GAP_SECONDS=90
# FETCH_DAILY_LIMIT=300

# Facultatif : adresse de contact ajoutée au User-Agent
# FETCH_CONTACT=ton@mail
