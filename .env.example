# À copier vers /etc/stickscans-<instance>.env (puis : chmod 600). Ne jamais commiter de vraies valeurs.
# Mets le mot de passe entre guillemets ; un seul $ par caractère $ (pas de doublement).
PORT=8430
AUTH_USERNAME=admin
AUTH_PASSWORD="change-moi"

# Décale les vérifications si tu as plusieurs instances (ex. 0 pour la première, 30 pour la seconde)
CHECK_OFFSET_MINUTES=0
CHECK_MIN_DELAY_SECONDS=2
CHECK_MAX_DELAY_SECONDS=4

# Pages partagées entre instances (même dossier pour toutes)
SCRAPE_CACHE_DIR=/opt/stickscans/cache

# Facultatif : adresse de contact ajoutée au User-Agent
# FETCH_CONTACT=ton@mail
