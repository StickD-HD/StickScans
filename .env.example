# Réglages d'une instance : à copier vers /etc/stickscans-<nom>.env, puis chmod 600.
# Ne jamais commiter de vraies valeurs. Pas de commentaire en fin de ligne : systemd l'inclurait dans la valeur.

PORT=8430

# Connexion. Mot de passe entre guillemets ; un seul $ par caractère $ (pas de doublement).
AUTH_USERNAME=admin
AUTH_PASSWORD="change-moi"
# Refuse de démarrer sans mot de passe (l'appli ne peut pas rester ouverte par oubli)
AUTH_REQUIRED=true

# Accès depuis Internet par un tunnel Cloudflare : cookie seulement en HTTPS, et vraie adresse des visiteurs
# (sans elle, 5 mauvais mots de passe tapés par n'importe qui bloquent la connexion pour tout le monde).
# Si tu ouvres l'appli en http://IP:PORT sur ton réseau, mets AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_SECURE=true
TRUST_CF_CONNECTING_IP=true

# Seulement si cloudflared / le reverse proxy tourne sur CETTE machine : l'appli n'écoute plus le réseau.
# HOST=127.0.0.1

# Dossier partagé par toutes les instances du serveur (le même partout) : pages récupérées, espacement des
# requêtes, plafond quotidien et pause après un refus du site.
SCRAPE_CACHE_DIR=/opt/stickscans/cache

# Facultatif : adresse de contact ajoutée au User-Agent
# FETCH_CONTACT=ton@mail
